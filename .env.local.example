# ─────────────────────────────────────────────────────────
# SETUP (one time lang):
#   1. cp .env.local.example .env
#   2. docker compose -f docker-compose.local.yml up -d
#   3. docker compose -f docker-compose.local.yml exec backend php artisan key:generate
#      (this writes a real APP_KEY into your .env automatically — see note below)
#   4. docker compose -f docker-compose.local.yml exec backend php artisan migrate --seed
# ─────────────────────────────────────────────────────────

APP_NAME=RIS
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000

# ── APP_KEY ─────────────────────────────────────────────
# Leave this blank. Do NOT copy someone else's key or reuse
# production's. Run this once after your containers are up:
#   docker compose -f docker-compose.local.yml exec backend php artisan key:generate
# It edits your local .env in place and fills this line in.
# Each teammate should have their own unique key.
APP_KEY=

# ── Database — local MySQL container, not RDS/production ──
# These values just need to match what docker-compose.local.yml
# uses to create the container. No need to change them unless
# you want a different local password for some reason.
DB_DATABASE=ris_local
DB_USERNAME=ris_local
DB_PASSWORD=local_dev_only
MYSQL_ROOT_PASSWORD=local_root_only

# ── Redis — local container, not production ────────────────
# Same as above: only needs to match the compose file, not be
# secret, since it's never reachable outside your own machine.
REDIS_PASSWORD=local_dev_only

# ── Reverb (WebSocket) — any values work locally ───────────
# These don't need to be real/unique — Reverb only needs
# *something* here to start. No action needed.
REVERB_APP_ID=local
REVERB_APP_KEY=local
REVERB_APP_SECRET=local

# ── Third-party integrations — ACTION MAY BE NEEDED ────────
# copy niyo lang kung anogn meron kayo here
ALUMNI_MOCK=true
SSO_BASE_URL=
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
OGOS_BASE_URL=
OGOS_CLIENT_ID=
OGOS_CLIENT_SECRET=
OCMS_BASE_URL=
OCMS_CLIENT_ID=
OCMS_CLIENT_SECRET=
CASHIER_API_KEY=
CASHIER_API_URL=

# ── File storage — stays on local disk ─────────────────────
# No AWS credentials needed for day-to-day development.
# Uploaded files just land in registrar-backend/storage/app.
FILESYSTEM_DISK=local
